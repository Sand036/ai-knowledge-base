# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# --- Supabase ---
# Hai biến NEXT_PUBLIC_ được phép lộ ra trình duyệt (URL và anon key là công khai,
# nhưng anon key chỉ an toàn khi đã bật RLS trên mọi bảng)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khóa này BỎ QUA RLS, chỉ dùng ở server, TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Chỉ dùng cho Supabase CLI (supabase link / db push), không cần cho ứng dụng ---
# SUPABASE_DB_PASSWORD=

# --- AI provider (chốt ở tuần 5) ---
# Chỉ dùng ở server, không thêm tiền tố NEXT_PUBLIC_
AI_API_KEY=
EMBEDDING_MODEL=
LLM_MODEL=
